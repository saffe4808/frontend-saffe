<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SAFFE - Escaneo facial</title>

    <link rel="stylesheet" href="/css/scaneo.css">
</head>

<body>

<header>
    <img src="/img/logo.png" alt="logo SAFFE" width="100">
    <h1>SAFFE</h1>
    <h2>Sistema de Control de Acceso Ejército Nacional</h2>
</header>

<main>

    <section id="scanner">

        <p id="instruccion-escaneo">Mire al frente y muestre su rostro completo</p>

        <div class="video-container">
            <video id="camara" autoplay playsinline muted></video>
            <canvas id="canvas-escaneo"></canvas>
        </div>

        <div class="controles">
            <button id="botonscan" disabled>CARGANDO MODELOS BIOMÉTRICOS...</button>
        </div>

        <div id="contenedor-mensaje">
            <p id="mensaje"></p>
        </div>

        <button id="btnAtras" onclick="window.location.href='/'">
            Atrás
        </button>

        <canvas id="foto" style="display:none;"></canvas>

    </section>

</main>

<script src="https://cdn.jsdelivr.net/npm/@vladmandic/human/dist/human.js"></script>
<script src="/config.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api/dist/face-api.js"></script>
<script src="/js/scaneo.js"></script>

</body>
</html>